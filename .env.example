# Agricultural AI Advisor - Environment Configuration
# Copy this file to .env and fill in your actual credentials

# Groq API Configuration (Required for AI features)
GROQ_API_KEY=your_groq_api_key_here

# Email Notification Configuration (Optional)
EMAIL_USER=your.email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_specific_password

# WhatsApp Notification Configuration via Twilio (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Weather API Configuration (Optional - for enhanced weather alerts)
OPENWEATHER_API_KEY=your_openweather_api_key

# Database Configuration (Optional - defaults to SQLite)
DATABASE_URL=sqlite:///data/agricultural_app.db

# Application Settings
DEBUG=False
LOG_LEVEL=INFO

# Security Settings
SECRET_KEY=your_secret_key_for_session_management

# Notification Settings
DEFAULT_NOTIFICATION_FREQUENCY=immediate
MAX_NOTIFICATIONS_PER_DAY=50

# Setup Instructions:
# 1. For Email Notifications:
#    - Enable 2-factor authentication on Gmail
#    - Generate app-specific password: https://myaccount.google.com/apppasswords
#    - Use the app-specific password for EMAIL_APP_PASSWORD
#
# 2. For WhatsApp Notifications:
#    - Sign up for Twilio account: https://www.twilio.com/
#    - Get Account SID and Auth Token from Twilio Console
#    - Enable WhatsApp sandbox for testing
#
# 3. For Weather Alerts:
#    - Sign up for OpenWeatherMap: https://openweathermap.org/api
#    - Get free API key (1000 calls/day limit)
#
# 4. For Groq AI:
#    - Sign up at https://console.groq.com/
#    - Generate API key from dashboard
